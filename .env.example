# Pronote login. Use the full address ending in eleve.html or parent.html.
PRONOTE_URL=https://your-school.index-education.net/pronote/parent.html
PRONOTE_USERNAME=your-username
PRONOTE_PASSWORD=your-password
PRONOTE_AUTH_MODE=password

# auto infers parent/student from the URL. For a parent with multiple children,
# copy the child's exact displayed name here.
PRONOTE_ACCOUNT_TYPE=auto
PRONOTE_CHILD_NAME=

# Leave blank for direct Pronote login. For an ENT, use the function name from
# https://pronotepy.readthedocs.io/en/stable/api/ent.html
PRONOTE_ENT=
PRONOTE_ACCOUNT_PIN=
PRONOTE_CREDENTIALS_PATH=/data/credentials.json

# Snapshot and schedule.
TZ=Europe/Paris
DAYS_PAST=7
DAYS_AHEAD=21
REFRESH_INTERVAL=900
OUTPUT_PATH=/data/homework.json
COMPLETION_PATH=/data/completions.json

# HTTP. Generate a long random key, especially if other devices share the LAN.
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
API_KEY=replace-with-output-of-openssl-rand-hex-24

# Optional MQTT. Leave MQTT_HOST empty to disable it. The full JSON snapshot is
# retained on MQTT_TOPIC, so a waking device receives the latest value once.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=pronote/homework
MQTT_EVENT_TOPIC=pronote/homework/done
MQTT_QOS=1
MQTT_TLS=false

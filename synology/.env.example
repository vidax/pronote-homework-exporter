# Safe template only. Copy this file to pronote.env and replace the placeholders.
# Never commit the resulting pronote.env file.

# Pronote login. Use the full address ending in eleve.html or parent.html.
PRONOTE_URL=https://your-school.index-education.net/pronote/parent.html
PRONOTE_USERNAME=your-username
PRONOTE_PASSWORD=replace-with-your-password
PRONOTE_AUTH_MODE=password

# auto detects parent/student from the URL. For a parent account containing
# several children, enter the exact displayed name of the desired child.
PRONOTE_ACCOUNT_TYPE=auto
PRONOTE_CHILD_NAME=

# Leave blank for a direct Pronote login. ENT users may need the corresponding
# PronotePy ENT function name.
PRONOTE_ENT=
PRONOTE_ACCOUNT_PIN=
PRONOTE_CREDENTIALS_PATH=/data/credentials.json

# Homework window and refresh frequency. REFRESH_INTERVAL is in seconds.
TZ=Europe/Paris
DAYS_PAST=7
DAYS_AHEAD=21
REFRESH_INTERVAL=900
OUTPUT_PATH=/data/homework.json
COMPLETION_PATH=/data/completions.json

# The container listens on 8080; Synology publishes it on port 855.
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Generate with: openssl rand -hex 24
API_KEY=replace-with-output-of-openssl-rand-hex-24

# Optional Mosquitto integration. Leave MQTT_HOST empty to disable it. Use the
# NAS LAN address, not 127.0.0.1, when Mosquitto runs outside this container.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=pronote/homework
MQTT_EVENT_TOPIC=pronote/homework/done
MQTT_QOS=1
MQTT_TLS=false
